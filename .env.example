# Copy this file to .env and fill in your values. Never commit .env to GitHub.

# Groq key from https://console.groq.com/keys
# Leave empty to run in "search only" mode (no LLM, just matching PDF sources).
LLM_API_KEY=

# Groq's OpenAI-compatible endpoint. Works with OpenAI or others by changing this.
LLM_BASE_URL=https://api.groq.com/openai/v1

# Pick a current model ID from https://console.groq.com/docs/models
# (model names change; check the list instead of trusting this example)
LLM_MODEL=llama-3.3-70b-versatile

# Embedding model (runs locally, free). English-focused, small and fast.
# For Danish content try: sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBED_MODEL=BAAI/bge-small-en-v1.5

# How many chunks to retrieve per question
TOP_K=6

# Search mode: vector (embeddings only), bm25 (keywords only) or hybrid (both).
# Compare with: python eval/run_eval.py   then set the winner here and on Render.
SEARCH_MODE=vector

# Key for the service endpoints the Next.js app uses (reindex, note summary, email draft).
# Make up a long random string. Leave empty to keep those endpoints switched off.
# Don't set it on Render until the Next.js app is deployed.
SERVICE_KEY=
