# Copy to .env (in this web/ folder) and fill in.

# Local SQLite database file, created on first start. Nothing to host.
DATABASE_URL=file:./payload.db

# Any long random string. Signs login sessions.
PAYLOAD_SECRET=

# The Python search service (the existing app.py) and the same SERVICE_KEY as in its .env.
PYTHON_API_URL=http://127.0.0.1:8000
SERVICE_KEY=

# Password for the demo logins created by `npm run seed`.
SEED_PASSWORD=demo-password-1

# Address of this web app, used in email links. Deployed: https://<your-app>.vercel.app
WEB_URL=http://localhost:3000
